[Unit]
Description=Quickshell desktop shell (menu bar, dock, dropdowns)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/quickshell
# If it ever crashes, bring the bar and dock back after a second
Restart=on-failure
RestartSec=1
Slice=app-graphical.slice

[Install]
WantedBy=graphical-session.target
