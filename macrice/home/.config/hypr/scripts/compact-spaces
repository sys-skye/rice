#!/usr/bin/python3 -I
"""Close the gaps left by empty Spaces, so each display's Spaces are always 1, 2, 3…

Hyprland already removes a Space once it is empty and you leave it, but the
others keep their numbers (1, 3, 4). This renumbers them (→ 1, 2, 3) by moving
each Space's windows down, and follows along if you're on one that moved.
A Space that lands on another display (moved there, or its display was
unplugged) is renumbered into that display's block (see scripts/space).
The Space you're on is never removed, even while empty.

  compact-spaces          compact once
  compact-spaces watch    compact whenever a Space goes away (runs all session)
"""
import importlib.machinery, importlib.util, json, os, socket, subprocess, sys, time

# shared numbering rules (scripts/space has no .py suffix, so load it by path)
_loader = importlib.machinery.SourceFileLoader("space", os.path.join(os.path.dirname(os.path.realpath(__file__)), "space"))
space = importlib.util.module_from_spec(importlib.util.spec_from_loader("space", _loader))
_loader.exec_module(space)

EVENTS = (b"destroyworkspace>>", b"closewindow>>", b"movewindow>>", b"moveworkspace>>",
          b"createworkspace>>", b"monitoradded>>", b"monitorremoved>>")


def hypr(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout


def query(what):
    try:
        return json.loads(hypr(what, "-j"))
    except json.JSONDecodeError:
        return [] if what != "activewindow" else {}


def compact():
    """Renumber each display's Spaces to its block (see scripts/space): base+1, base+2…

    Only moves whose target number is free are done; the events they cause run
    this again, so chains (a Space moved to the other display) settle in a few passes.
    """
    monitors = query("monitors")
    spaces = [w for w in query("workspaces") if w["id"] > 0]
    taken = {w["id"] for w in spaces}
    moves = {}  # old id -> (new id, display)
    for m in monitors:
        b = space.base(m["name"], monitors)
        mine = sorted((w["id"] for w in spaces if w["monitor"] == m["name"]),
                      key=lambda i: (not space.in_block(i, b), i))
        moves.update({old: (new, m["name"]) for new, old in enumerate(mine, b + 1) if old != new})
    ready = {old: t for old, t in moves.items() if t[0] not in taken}
    if not ready:
        if moves:  # every target is busy (two Spaces swapped displays): park one on a spare number
            old, (new, mon) = next(iter(moves.items()))
            b = space.base(mon, monitors)
            ready = {old: (next(i for i in range(b + 50, b + 100) if i not in taken), mon)}
        else:
            return
    shown = {m["activeWorkspace"]["id"]: m["name"] for m in monitors}
    focused_mon = next((m["name"] for m in monitors if m["focused"]), None)
    focused_win = query("activewindow").get("address")

    cmds = []
    for c in query("clients"):
        if c["workspace"]["id"] in ready:
            new = ready[c["workspace"]["id"]][0]
            cmds.append(f"dispatch hl.dsp.window.move({{ workspace = {new}, follow = false, window = 'address:{c['address']}' }})")
    # Displays showing a renumbered Space switch to its new number (no slide animation)
    follow = [(mon, ready[old][0]) for old, mon in shown.items() if old in ready]
    if follow:
        for mon, new in follow:
            cmds += [f"dispatch hl.dsp.focus({{ monitor = '{mon}' }})", f"dispatch hl.dsp.focus({{ workspace = {new} }})"]
        if focused_mon:
            cmds.append(f"dispatch hl.dsp.focus({{ monitor = '{focused_mon}' }})")
        if focused_win:
            cmds.append(f"dispatch hl.dsp.focus({{ window = 'address:{focused_win}' }})")
        option = hypr("getoption", "animations:enabled")
        animations = "bool: true" in option or "int: 1" in option
        if animations:
            cmds = ["eval hl.config({ animations = { enabled = false } })", *cmds,
                    "eval hl.config({ animations = { enabled = true } })"]
    if cmds:
        hypr("--batch", "; ".join(cmds))


def watch():
    path = f"{os.environ['XDG_RUNTIME_DIR']}/hypr/{os.environ['HYPRLAND_INSTANCE_SIGNATURE']}/.socket2.sock"
    sock = socket.socket(socket.AF_UNIX)
    sock.connect(path)
    sock.settimeout(0.15)
    compact()
    due, buf = None, b""
    while True:
        try:
            data = sock.recv(65536)
            if not data:
                return
            buf += data
            *lines, buf = buf.split(b"\n")
            if any(l.startswith(EVENTS) for l in lines):
                due = time.monotonic() + 0.15  # let bursts (closing several windows) settle
        except socket.timeout:
            pass
        if due and time.monotonic() >= due:
            due = None
            compact()


if __name__ == "__main__":
    watch() if sys.argv[1:] == ["watch"] else compact()
