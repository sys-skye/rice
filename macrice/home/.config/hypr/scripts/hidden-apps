#!/usr/bin/python3 -I
"""Bring apps that ⌘Q hid (special:hidden) back when something activates them.

Opening Thunderbird/KeePassXC again (search, a notification, the browser asking
KeePassXC to unlock) makes Hyprland focus the hidden window, which would show
the whole hidden Space as an overlay. Instead, move that window to the Space
you're on and keep the hidden Space hidden.

  hidden-apps watch    (exec-once in autostart.conf)
"""
import json, os, socket, subprocess


def hypr(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout


def bring_back(monitor):
    try:
        win = json.loads(hypr("activewindow", "-j"))
        mon = next(m for m in json.loads(hypr("monitors", "-j")) if m["name"] == monitor)
    except (json.JSONDecodeError, StopIteration):
        return
    cmds = ["dispatch togglespecialworkspace hidden"]
    if win.get("workspace", {}).get("name") == "special:hidden":
        ws = mon["activeWorkspace"]["id"]
        cmds += [f"dispatch movetoworkspace {ws},address:{win['address']}",
                 f"dispatch focuswindow address:{win['address']}"]
    hypr("--batch", "; ".join(cmds))


def watch():
    path = f"{os.environ['XDG_RUNTIME_DIR']}/hypr/{os.environ['HYPRLAND_INSTANCE_SIGNATURE']}/.socket2.sock"
    sock = socket.socket(socket.AF_UNIX)
    sock.connect(path)
    buf = b""
    while True:
        data = sock.recv(65536)
        if not data:
            return
        buf += data
        *lines, buf = buf.split(b"\n")
        for line in lines:
            # activespecial>>special:hidden,eDP-1  (shown; empty name = hidden again)
            if line.startswith(b"activespecial>>special:hidden,"):
                bring_back(line.decode().split(",", 1)[1])


if __name__ == "__main__":
    watch()
