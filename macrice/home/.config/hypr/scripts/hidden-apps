#!/usr/bin/python3 -I
"""Bring apps that ⌘Q hid (special:hidden) or ⌘M minimized (special:minimized)
back when something activates them.

Opening Thunderbird/KeePassXC again (search, a notification, the browser asking
KeePassXC to unlock), clicking a minimized app in the dock or a link opening a
minimized Firefox makes Hyprland focus the hidden window, which would show the
whole hidden Space as an overlay. Instead, move that window to the Space you're
on and keep the hidden Space hidden. ⌘⇧M (show minimized windows on purpose)
leaves a marker file so that one overlay stays.

  hidden-apps watch    (exec-once in autostart.conf)
"""
import json, os, socket, subprocess, time

PEEK = f"{os.environ.get('XDG_RUNTIME_DIR', '/tmp')}/minimized-peek"  # written by ⌘⇧M


def hypr(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout


def bring_back(special, monitor):
    try:
        win = json.loads(hypr("activewindow", "-j"))
        mon = next(m for m in json.loads(hypr("monitors", "-j")) if m["name"] == monitor)
    except (json.JSONDecodeError, StopIteration):
        return
    cmds = [f"dispatch hl.dsp.workspace.toggle_special('{special.removeprefix('special:')}')"]
    if win.get("workspace", {}).get("name") == special:
        ws = mon["activeWorkspace"]["id"]
        cmds += [f"dispatch hl.dsp.window.move({{ workspace = {ws}, window = 'address:{win['address']}' }})",
                 f"dispatch hl.dsp.focus({{ window = 'address:{win['address']}' }})"]
    hypr("--batch", "; ".join(cmds))


def watch():
    path = f"{os.environ['XDG_RUNTIME_DIR']}/hypr/{os.environ['HYPRLAND_INSTANCE_SIGNATURE']}/.socket2.sock"
    sock = socket.socket(socket.AF_UNIX)
    sock.connect(path)
    buf = b""
    while True:
        data = sock.recv(65536)
        if not data:
            return
        buf += data
        *lines, buf = buf.split(b"\n")
        for line in lines:
            # activespecial>>special:hidden,eDP-1  (shown; empty name = hidden again)
            if line.startswith((b"activespecial>>special:hidden,", b"activespecial>>special:minimized,")):
                special, monitor = line.decode().removeprefix("activespecial>>").split(",", 1)
                if special == "special:minimized" and peeking():
                    continue
                bring_back(special, monitor)


def peeking():
    """⌘⇧M opened the minimized Space on purpose (within the last second)."""
    try:
        fresh = time.time() - os.path.getmtime(PEEK) < 1
        os.remove(PEEK)
        return fresh
    except OSError:
        return False


if __name__ == "__main__":
    watch()
