#!/usr/bin/python3 -I
"""Per-display Spaces (like macOS "Displays have separate Spaces").

Every display owns its own block of Hyprland workspace ids, so its Spaces are
numbered 1, 2, 3… independently of the other screen:

  MacBook (eDP-1)        1 … 99
  HDMI-A-1             101 … 199
  any other output     201 …, 301 … (by name)

monitors.conf pins those ids to their display, so Spaces created any way
(keys, swipes, session restore) open on the right screen. compact-spaces
keeps each block gap-free.

  space go N|new          show Space N of the focused display (or a new one)
  space move N|new [ADDR] move the window there and follow it
  space send N|new [ADDR] move the window there, stay here
  space next|prev         neighbouring Space on this display (next can add one)
  space movenext|moveprev move the window to the neighbouring Space
"""
import json, subprocess, sys

BUILTIN = "eDP-1"
KNOWN = {"eDP-1": 0, "HDMI-A-1": 100}


def hypr(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout


def query(what):
    try:
        return json.loads(hypr(what, "-j"))
    except json.JSONDecodeError:
        return {} if what.startswith("active") else []


def base(name, monitors):
    """First id (minus one) of a display's block."""
    if name in KNOWN:
        return KNOWN[name]
    others = sorted(m["name"] for m in monitors if m["name"] not in KNOWN)
    return 100 * (len(KNOWN) + others.index(name)) if name in others else 0


def in_block(ws_id, b):
    return b < ws_id < b + 100


def main(argv):
    if not argv:
        sys.exit(__doc__)
    action, arg = argv[0], argv[1] if len(argv) > 1 else None
    addr = argv[2] if len(argv) > 2 else None

    monitors = query("monitors")
    workspaces = [w for w in query("workspaces") if w["id"] > 0]
    if addr:  # act on that window's display
        win = next((c for c in query("clients") if c["address"] == addr), None)
        mon = next((m for m in monitors if win and m["id"] == win["monitor"]), None)
    else:
        mon = next((m for m in monitors if m["focused"]), None)
    if not mon:
        return
    b = base(mon["name"], monitors)
    mine = sorted((w for w in workspaces if w["monitor"] == mon["name"]),
                  key=lambda w: (not in_block(w["id"], b), w["id"]))
    ids = [w["id"] for w in mine]
    current = mon["activeWorkspace"]["id"]
    idx = ids.index(current) + 1 if current in ids else 1
    taken = {w["id"] for w in workspaces}
    fresh = next(i for i in range(b + 1, b + 100) if i not in taken and i > max([b, *(i for i in ids if in_block(i, b))]))

    def nth(n):
        return ids[n - 1] if 1 <= n <= len(ids) else fresh

    target_addr = f",address:{addr}" if addr else ""
    if action in ("go", "move", "send"):
        target = fresh if arg == "new" else nth(max(1, int(arg)))
        dispatcher = {"go": "workspace", "move": "movetoworkspace", "send": "movetoworkspacesilent"}[action]
        hypr("dispatch", dispatcher, f"{target}{target_addr if action != 'go' else ''}")
    elif action in ("next", "movenext"):
        empty_here = next((w["windows"] == 0 for w in mine if w["id"] == current), False)
        if idx < len(ids) or not empty_here:  # step past the last Space only if it has windows
            hypr("dispatch", "workspace" if action == "next" else "movetoworkspace", str(nth(idx + 1)))
    elif action in ("prev", "moveprev"):
        if idx > 1:
            hypr("dispatch", "workspace" if action == "prev" else "movetoworkspace", str(nth(idx - 1)))
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
