#!/usr/bin/env bash
# Reboot into macOS once. The next restart after that comes back to Linux.
#   reboot-macos         ask, then reboot
#   reboot-macos -y      no question
#   reboot-macos --set   don't reboot, just make the next boot macOS
set -e
if ! command -v asahi-bless >/dev/null; then
    echo "Needs asahi-bless:  sudo dnf install asahi-bless" >&2
    exit 1
fi
case $1 in
    -y|--yes) yes=1 ;;
    --set) sudo asahi-bless --set-boot-macos --next --autoconfirm; echo "Next boot: macOS"; exit ;;
esac
if [[ -z $yes ]]; then
    read -rp "Reboot into macOS now? Unsaved work in open apps will be lost. [y/N] " a
    [[ $a == [yY]* ]] || exit 0
fi
sudo asahi-bless --set-boot-macos --next --autoconfirm
systemctl reboot
